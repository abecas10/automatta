---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import Stamp from '../components/Stamp.astro';
import es from '../content/es';
---

<Base title="Página no encontrada · Automatta" noindex>
  <main id="contenido" class="grid min-h-[100svh] place-items-center px-5 py-16">
    <div class="w-full max-w-md text-center">
      <a href="/" class="inline-block" aria-label="Automatta, inicio"><Logo class="text-[17px]" /></a>
      <div class="nf-doc doc relative mx-auto mt-12 w-64 rotate-[-3deg] p-5 text-left" aria-hidden="true">
        <div class="flex items-center justify-between text-xs text-muted">
          <span>Factura</span>
          <span class="tnum">F-0404</span>
        </div>
        <p class="t-display tnum mt-3 text-7xl">404</p>
        <div class="mt-3 h-2 w-3/4 rounded bg-ink/10"></div>
        <div class="mt-2 h-2 w-1/2 rounded bg-ink/10"></div>
        <Stamp label="No encontrada" tone="red" rotate={-12} class="absolute right-3 bottom-4 text-[0.8rem]" />
      </div>
      <h1 class="h-sub mt-12">{es.notFound.title}</h1>
      <p class="mx-auto mt-4 max-w-[40ch] text-muted">{es.notFound.text}</p>
      <div class="mt-10"><Button href="/">{es.notFound.cta}</Button></div>
    </div>
  </main>
</Base>

<style>
  .nf-doc {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }
</style>
