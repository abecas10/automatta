---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import es from '../content/es';
---

<Base title="Página no encontrada · Automatta" noindex>
  <main id="contenido" class="dark relative isolate grid min-h-[100svh] place-items-center overflow-hidden bg-ink px-5 text-paper">
    <div class="mesh" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="relative text-center">
      <a href="/" class="inline-block" aria-label="Automatta, inicio"><Logo class="mx-auto h-8 w-auto" tone="light" /></a>
      <div class="nf-invoice mx-auto mt-14 w-64 rotate-[-4deg] rounded-2xl border border-white/10 bg-ink-2 p-5 text-left shadow-2xl" aria-hidden="true">
        <div class="flex items-center justify-between text-xs text-paper/60">
          <span>Factura</span>
          <span class="rounded-full bg-alert/15 px-2 py-0.5 font-semibold text-alert">No encontrada</span>
        </div>
        <p class="tnum mt-3 font-display text-7xl font-extrabold tracking-tight">404</p>
        <div class="mt-3 h-2 w-3/4 rounded bg-white/10"></div>
        <div class="mt-2 h-2 w-1/2 rounded bg-white/10"></div>
      </div>
      <h1 class="mt-12 font-display text-4xl font-extrabold sm:text-5xl">{es.notFound.title}</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-paper/70">{es.notFound.text}</p>
      <div class="mt-10"><Button href="/" arrow>{es.notFound.cta}</Button></div>
    </div>
  </main>
</Base>

<style>
  .nf-invoice {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: translateY(-12px) rotate(3deg);
    }
  }
</style>
