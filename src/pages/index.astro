---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Transformation from '../components/sections/Transformation.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Verifactu from '../components/sections/Verifactu.astro';
import Audience from '../components/sections/Audience.astro';
import Roadmap from '../components/sections/Roadmap.astro';
import Survey from '../components/sections/Survey.astro';
import Team from '../components/sections/Team.astro';
import Faq from '../components/sections/Faq.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base>
  <Navbar />
  <main id="contenido">
    <Hero />
    <Problem />
    <Transformation />
    <HowItWorks />
    <Verifactu />
    <Audience />
    <Roadmap />
    <Survey />
    <Team />
    <Faq />
  </main>
  <Footer />
</Base>
