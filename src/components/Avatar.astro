---
// Retrato de fundador. Hoy muestra iniciales; cuando haya foto, pasa `photo`
// (por ejemplo, una imagen importada de src/assets) y se mostrará en su lugar.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  initials: string;
  name: string;
  photo?: ImageMetadata;
  class?: string;
}
const { initials, name, photo, class: className = '' } = Astro.props;
---

<div class:list={['relative aspect-[4/5] w-full overflow-hidden rounded-lg bg-paper-2', className]}>
  {
    photo ? (
      <Image src={photo} alt={name} class="h-full w-full object-cover" widths={[320, 640]} sizes="(min-width: 640px) 320px, 45vw" />
    ) : (
      <div class="grid h-full w-full place-items-center" role="img" aria-label={name}>
        <span class="t-display text-[clamp(2.5rem,8vw,4.5rem)] text-ink/70" aria-hidden="true">
          {initials}
        </span>
      </div>
    )
  }
</div>
