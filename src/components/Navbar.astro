---
import Logo from './Logo.astro';
import Button from './Button.astro';
import es from '../content/es';
import { SURVEY_URL } from '../config';
---

<header data-navbar class="nav fixed inset-x-0 top-0 z-50 text-paper">
  <div class="container-x">
    <nav
      class="nav-inner mt-3 flex h-14 items-center justify-between gap-4 rounded-full px-2 pl-4 transition-[background-color,box-shadow,border-color] duration-500"
      aria-label="Principal"
    >
      <a href="/" class="relative z-[60] shrink-0 rounded-md" aria-label="Automatta, inicio">
        <Logo class="h-7 w-auto" tone="light" />
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {
          es.nav.links.map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded-full px-3.5 py-2 text-sm font-medium text-paper/75 transition-colors hover:bg-white/8 hover:text-paper"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <Button href={SURVEY_URL} external class="!min-h-10 !px-4 !py-2 !text-sm max-[420px]:hidden">
          {es.nav.cta}
        </Button>
        <button
          type="button"
          class="relative z-[60] grid h-11 w-11 place-items-center rounded-full lg:hidden"
          aria-expanded="false"
          aria-controls="menu-movil"
          data-menu-button
          data-open={es.nav.openMenu}
          data-close={es.nav.closeMenu}
        >
          <span class="sr-only" data-menu-label>{es.nav.openMenu}</span>
          <span class="burger" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </nav>
  </div>

  <div
    id="menu-movil"
    class="menu-panel fixed inset-0 z-[55] flex flex-col bg-ink/95 px-6 pt-28 pb-10 backdrop-blur-xl lg:hidden"
    data-menu-panel
  >
    <ul class="flex flex-col gap-1">
      {
        es.nav.links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} class="block py-3 font-display text-4xl font-bold tracking-tight text-paper">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto" style={`--i:${es.nav.links.length}`}>
      <Button href={SURVEY_URL} external class="w-full" arrow>{es.nav.cta}</Button>
    </div>
  </div>
</header>

<style>
  .nav-inner {
    border: 1px solid transparent;
  }
  .nav:global(.is-scrolled) .nav-inner,
  :global(.menu-open) .nav-inner {
    background: rgb(11 16 32 / 0.86);
    border-color: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow: 0 10px 40px -10px rgb(0 0 0 / 0.45);
  }
  :global(.menu-open) .nav-inner {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .burger {
    position: relative;
    width: 22px;
    height: 14px;
  }
  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out-expo),
      top 0.45s var(--ease-out-expo);
  }
  .burger span:first-child {
    top: 2px;
  }
  .burger span:last-child {
    top: 10px;
  }
  [aria-expanded='true'] .burger span:first-child {
    top: 6px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .burger span:last-child {
    top: 6px;
    transform: rotate(-45deg);
  }

  .menu-panel {
    opacity: 0;
    visibility: hidden;
    clip-path: circle(0% at calc(100% - 44px) 44px);
    transition:
      clip-path 0.7s var(--ease-out-expo),
      opacity 0.3s,
      visibility 0s linear 0.7s;
  }
  .menu-panel[data-open] {
    opacity: 1;
    visibility: visible;
    clip-path: circle(150% at calc(100% - 44px) 44px);
    transition:
      clip-path 0.7s var(--ease-out-expo),
      opacity 0.2s,
      visibility 0s;
  }
  .menu-panel li,
  .menu-panel > div {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s,
      transform 0.6s var(--ease-out-expo);
  }
  .menu-panel[data-open] li,
  .menu-panel[data-open] > div {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.15s + var(--i) * 0.05s);
  }
</style>
