---
import Logo from './Logo.astro';
import Button from './Button.astro';
import es from '../content/es';
import { SURVEY_URL } from '../config';
---

<header data-navbar class="nav fixed inset-x-0 top-0 z-50">
  <div class="container-x">
    <nav class="flex h-16 items-center justify-between gap-6" aria-label="Principal">
      <a href="/" class="relative z-[60] shrink-0 rounded-md" aria-label="Automatta, inicio">
        <Logo class="text-[17px]" />
      </a>

      <ul class="hidden items-center gap-7 lg:flex">
        {
          es.nav.links.map((l) => (
            <li>
              <a href={l.href} class="nav-link text-[0.9375rem] font-medium text-ink/75 hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-3">
        <Button href={SURVEY_URL} external class="!min-h-10 !px-4 !text-sm max-[420px]:hidden">{es.nav.cta}</Button>
        <button
          type="button"
          class="relative z-[60] -mr-2 grid h-11 w-11 place-items-center rounded-md lg:hidden"
          aria-expanded="false"
          aria-controls="menu-movil"
          data-menu-button
          data-open={es.nav.openMenu}
          data-close={es.nav.closeMenu}
        >
          <span class="sr-only" data-menu-label>{es.nav.openMenu}</span>
          <span class="burger" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </nav>
  </div>

  <div id="menu-movil" class="menu-panel fixed inset-0 z-[55] flex flex-col bg-paper px-5 pt-24 pb-8 lg:hidden" data-menu-panel>
    <ul class="flex flex-col border-t border-line">
      {
        es.nav.links.map((l, i) => (
          <li style={`--i:${i}`} class="border-b border-line">
            <a href={l.href} class="t-display block py-4 text-3xl text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto" style={`--i:${es.nav.links.length}`}>
      <Button href={SURVEY_URL} external size="lg" class="w-full">{es.nav.cta}</Button>
    </div>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }
  .nav:global(.is-scrolled) {
    background: rgb(245 246 243 / 0.92);
    border-color: var(--color-line);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  :global(.menu-open) .nav {
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
  }
  .nav-link {
    position: relative;
    transition: color 0.2s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out-quart);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .burger {
    position: relative;
    width: 22px;
    height: 14px;
  }
  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out-expo),
      top 0.45s var(--ease-out-expo);
  }
  .burger span:first-child {
    top: 2px;
  }
  .burger span:last-child {
    top: 11px;
  }
  [aria-expanded='true'] .burger span:first-child {
    top: 6.5px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .burger span:last-child {
    top: 6.5px;
    transform: rotate(-45deg);
  }

  .menu-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out-quart),
      visibility 0s linear 0.4s;
  }
  .menu-panel[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.25s,
      transform 0.4s var(--ease-out-quart),
      visibility 0s;
  }
  .menu-panel li,
  .menu-panel > div {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease-out-quart);
  }
  .menu-panel[data-open] li,
  .menu-panel[data-open] > div {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.1s + var(--i) * 0.04s);
  }
</style>
