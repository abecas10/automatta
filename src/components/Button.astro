---
import es from '../content/es';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  size?: 'md' | 'lg';
  class?: string;
}
const { href, variant = 'primary', external = false, size = 'md', class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary', size === 'lg' && 'btn-lg', className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
  {external && <span class="sr-only">{es.common.newTab}</span>}
</a>
