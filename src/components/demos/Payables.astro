---
// 01 · Facturas de proveedores: el PDF entra en el buzón, se lee solo y se aprueba desde el móvil.
import es from '../../content/es';
const d = es.how.demoPayables;
---

<div class="pt-8" data-payables>
  <div class="flex items-center gap-2 rounded-lg border border-black/8 bg-paper px-3 py-2 text-xs text-muted">
    <svg class="h-4 w-4 shrink-0 text-violet" viewBox="0 0 16 16" fill="none">
      <path d="M2 4h12v8H2zM2 4l6 5 6-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    </svg>
    <span class="truncate">{d.inbox}</span>
  </div>

  <div class="mt-4 grid grid-cols-[auto_minmax(0,1fr)] gap-4">
    <!-- PDF -->
    <div class="pp-pdf relative h-36 w-24 overflow-hidden rounded-lg border border-black/10 bg-white p-2.5 shadow-md sm:w-28">
      <span class="rounded bg-alert/15 px-1 text-[9px] font-bold text-alert-dark">PDF</span>
      <div class="mt-2 space-y-1.5">
        <div class="h-1.5 w-3/4 rounded bg-ink/15"></div>
        <div class="h-1.5 w-1/2 rounded bg-ink/10"></div>
        <div class="mt-3 h-1.5 w-full rounded bg-ink/10"></div>
        <div class="h-1.5 w-full rounded bg-ink/10"></div>
        <div class="h-1.5 w-2/3 rounded bg-ink/10"></div>
        <div class="mt-3 ml-auto h-2 w-1/2 rounded bg-ink/20"></div>
      </div>
      <p class="absolute inset-x-0 bottom-1 truncate px-1.5 text-center text-[8px] text-muted">{d.file}</p>
      <span class="pp-scan absolute inset-x-0 top-0 h-8 bg-gradient-to-b from-transparent via-money/40 to-transparent"></span>
    </div>

    <!-- Campos leídos -->
    <dl class="flex flex-col justify-center gap-2">
      {
        d.fields.map((f) => (
          <div class="pp-field flex items-center justify-between gap-2 rounded-lg bg-paper px-3 py-1.5">
            <dt class="text-[11px] text-muted">{f.label}</dt>
            <dd class="pp-value tnum truncate text-xs font-semibold">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="mt-5 flex items-end justify-between gap-4">
    <div class="flex flex-col gap-2">
      <div class="flex flex-wrap gap-2">
        {
          d.checks.map((c) => (
            <span class="pp-check inline-flex items-center gap-1.5 rounded-full bg-money/15 px-2.5 py-1 text-xs font-semibold text-money-dark">
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none">
                <path d="M3.5 8.5l3 3L12.5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {c}
            </span>
          ))
        }
      </div>
      <p class="pp-transfer inline-flex items-center gap-2 text-xs font-medium text-muted">
        <svg class="h-4 w-4 shrink-0 text-violet" viewBox="0 0 16 16" fill="none">
          <path d="M2 6h11l-3-3M14 10H3l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {d.transfer}
      </p>
    </div>

    <!-- Móvil -->
    <div class="pp-phone relative w-24 shrink-0 rounded-[18px] border-[3px] border-ink bg-white p-2 pt-4 shadow-lg sm:w-28">
      <span class="absolute top-1 left-1/2 h-1 w-8 -translate-x-1/2 rounded-full bg-ink/80"></span>
      <p class="truncate text-[9px] text-muted">{d.fields[0].value}</p>
      <p class="tnum text-sm font-bold">{d.fields[1].value}</p>
      <div class="relative mt-2 h-7">
        <span class="pp-approve absolute inset-0 grid place-items-center rounded-lg bg-ink text-[11px] font-semibold text-paper">{d.approve}</span>
        <span class="pp-approved absolute inset-0 grid place-items-center rounded-lg bg-money text-[11px] font-semibold text-ink">{d.approved} ✓</span>
      </div>
      <span class="pp-tap absolute right-4 bottom-3 h-6 w-6 rounded-full border-2 border-violet bg-violet/20"></span>
    </div>
  </div>
</div>

<style>
  .pp-tap {
    opacity: 0;
  }
  :global(.js-motion) .pp-approved {
    opacity: 0;
  }
  :global(:root:not(.js-motion)) .pp-scan {
    display: none;
  }
</style>
