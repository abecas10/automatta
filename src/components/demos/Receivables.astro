---
// 02 · Facturas a clientes y cobros: reclamación escalonada (día 3 → 20 → 40) hasta que se cobra.
import Stamp from '../Stamp.astro';
import es from '../../content/es';
const c = es.how.demoCobros;
const pillStyle = ['pill-red', 'pill-ink', 'pill-ink', 'pill-green'];
const nodeStyle = ['border-ink text-ink', 'border-ink text-ink', 'border-red text-red'];
---

<div data-cobros>
  <div class="rounded-md bg-paper p-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="t-data text-xs text-muted">{c.invoice}</p>
        <p class="mt-0.5 font-medium">{c.client}</p>
      </div>
      <p class="t-display tnum text-2xl">{c.amount}</p>
    </div>
    <div class="relative mt-4 h-7">
      {c.states.map((s, i) => <span class:list={['cb-pill pill absolute left-0', `cb-pill-${i}`, pillStyle[i]]}>{s}</span>)}
    </div>
  </div>

  <ol class="relative mt-6 grid grid-cols-3 gap-2">
    <span class="absolute top-[13px] right-[16%] left-[16%] h-px bg-line"></span>
    <span class="cb-progress absolute top-[13px] right-[16%] left-[16%] h-px origin-left bg-ink"></span>
    {
      c.steps.map((s, i) => (
        <li class="cb-node relative flex flex-col items-center gap-1.5 text-center" data-i={i}>
          <span class:list={['cb-dot tnum grid h-7 w-7 place-items-center rounded-full border bg-white text-[11px] font-semibold', nodeStyle[i]]}>{i + 1}</span>
          <span class="tnum text-xs font-semibold">{s.day}</span>
          <span class="t-data text-[11px] leading-tight text-muted">{s.label}</span>
        </li>
      ))
    }
  </ol>

  <div class="mt-6 flex items-center gap-4">
    <div class="cb-mail doc flex min-w-0 items-center gap-2 !rounded-md px-3 py-2 text-xs">
      <svg class="h-4 w-4 shrink-0 text-ink" viewBox="0 0 16 16" fill="none">
        <path d="M1.5 7.5L14.5 2l-4 12-3-5-6-1.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
      </svg>
      <span class="truncate">{c.mail}</span>
    </div>
    <div class="ml-auto shrink-0">
      <Stamp label={c.states[3]} rotate={-8} press class="cb-stamp text-[0.95rem]" />
    </div>
  </div>
</div>

<style>
  /* Sin animación se ve el estado final (Cobrada); con animación, el inicial (Vencida). */
  .cb-pill {
    opacity: 0;
  }
  .cb-pill-3 {
    opacity: 1;
  }
  :global(.js-motion) .cb-pill-0 {
    opacity: 1;
  }
  :global(.js-motion) .cb-pill-3 {
    opacity: 0;
  }
  :global(:root:not(.js-motion)) .cb-progress {
    transform: scaleX(1);
  }
</style>
