---
// 05 · Gastos e impuestos: foto al ticket → gasto registrado → borrador del modelo 303.
import Stamp from '../Stamp.astro';
import es from '../../content/es';
const d = es.how.demoTaxes;
---

<div class="flex flex-col gap-4 sm:grid sm:grid-cols-[auto_minmax(0,1fr)] sm:items-start" data-taxes>
  <!-- Móvil con la foto del ticket -->
  <div class="flex items-center justify-center gap-4 sm:flex-col sm:gap-3">
    <div class="relative w-28 rounded-[20px] border-[3px] border-ink bg-ink p-1.5 shadow-lg sm:w-32">
      <div class="relative overflow-hidden rounded-[14px] bg-ink-3 px-3 pt-4 pb-3">
        <!-- Esquinas del visor -->
        <span class="absolute top-2 left-2 h-3 w-3 border-t-2 border-l-2 border-mint"></span>
        <span class="absolute top-2 right-2 h-3 w-3 border-t-2 border-r-2 border-mint"></span>
        <span class="absolute bottom-2 left-2 h-3 w-3 border-b-2 border-l-2 border-mint"></span>
        <span class="absolute right-2 bottom-2 h-3 w-3 border-r-2 border-b-2 border-mint"></span>
        <div class="tx-ticket mx-auto w-[80%] rounded-sm bg-white px-2 py-2 text-ink shadow">
          <p class="t-data truncate text-[8px] font-semibold">{d.ticket}</p>
          <div class="mt-1.5 space-y-1">
            <div class="h-1 w-full rounded bg-ink/15"></div>
            <div class="h-1 w-3/4 rounded bg-ink/15"></div>
            <div class="h-1 w-5/6 rounded bg-ink/15"></div>
          </div>
          <p class="tnum mt-1.5 text-right text-[10px] font-semibold">{d.ticketAmount}</p>
        </div>
        <span class="tx-flash pointer-events-none absolute inset-0 bg-white"></span>
      </div>
      <div class="mx-auto mt-1.5 h-5 w-5 rounded-full border-2 border-paper/70"></div>
    </div>
    <span class="tx-registered pill pill-green">
      <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none">
        <path d="M3.5 8.5l3 3L12.5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {d.registered}
    </span>
  </div>

  <!-- Borrador del modelo 303 -->
  <div class="tx-form relative rounded-md bg-paper p-3 sm:p-4">
    <div class="flex flex-wrap items-center justify-between gap-2 pr-16">
      <p class="text-xs font-medium sm:text-sm">{d.formTitle}</p>
    </div>
    <dl class="mt-3 flex flex-col gap-1.5">
      {
        d.rows.map((r, i) => (
          <div class:list={['tx-row flex items-center justify-between gap-2 rounded-md px-2.5 py-1.5', i === d.rows.length - 1 ? 'doc-ink !rounded-md' : 'bg-white']}>
            <dt class:list={['t-data text-[11px]', i === d.rows.length - 1 ? 'text-muted-dark' : 'text-muted']}>{r.label}</dt>
            <dd class="tnum text-xs font-medium whitespace-nowrap sm:text-sm">{r.value}</dd>
          </div>
        ))
      }
    </dl>
    <span class="tx-cta mt-3 grid h-8 place-items-center rounded-md bg-ink text-xs font-medium text-paper">{d.cta}</span>
    <Stamp label={d.draft} rotate={8} press class="tx-stamp absolute -top-2 right-2 text-[0.7rem]" />
  </div>
</div>

<style>
  .tx-flash {
    opacity: 0;
  }
</style>
