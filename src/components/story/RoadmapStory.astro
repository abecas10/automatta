---
import SectionHead from '../SectionHead.astro';
import es from '../../content/es';

const r = es.roadmap;
---

<section id="hoja-de-ruta" class="section roadmap" aria-labelledby="ruta-title">
  <div class="container-x">
    <SectionHead name={r.eyebrow} title={r.title} id="ruta-title" />
    <ol class="rm mt-12 grid gap-8 md:grid-cols-4 md:gap-6 lg:mt-16">
      {
        r.items.map((item) => (
          <li class:list={['rm-item border-t-2 pt-5', item.current ? 'border-green' : 'border-line']}>
            <p class="tnum flex items-center gap-2 text-[0.9375rem] font-medium text-green">
              {item.when}
              {item.current && <span class="pill pill-green">{r.here}</span>}
            </p>
            <h3 class="mt-2 text-[1.375rem]">{item.title}</h3>
            <p class="mt-2 max-w-[32ch] text-muted">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
