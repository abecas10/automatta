---
import Chapter from '../Chapter.astro';
import es from '../../content/es';
import { VERIFACTU_DATE } from '../../config';
import { CH } from '../../scripts/world/chapters';

const v = es.verifactu;
const st = es.story.steps.verifactu;
const a = es.story.actions;
// Valor inicial calculado en el build; el JS lo actualiza cada segundo.
const diff = Math.max(0, new Date(VERIFACTU_DATE).getTime() - Date.now());
const sec = Math.floor(diff / 1000);
const pad = (n: number) => String(n).padStart(2, '0');
const units = [
  { key: 'days', value: String(Math.floor(sec / 86400)), label: v.units.days },
  { key: 'hours', value: pad(Math.floor((sec % 86400) / 3600)), label: v.units.hours },
  { key: 'minutes', value: pad(Math.floor((sec % 3600) / 60)), label: v.units.minutes },
  { key: 'seconds', value: pad(sec % 60), label: v.units.seconds },
];
---

<section id="verifactu" class="story dark bg-ink text-paper" aria-labelledby="verifactu-title">
  <div class="container-x">
    <Chapter index={CH.verifactu} kicker={st.kicker} title={v.title} caption={st.caption} level={2} titleId="verifactu-title">
      <p>{v.text}</p>
      <p>{v.why}</p>
      <blockquote>{v.quote}</blockquote>
      <p>{v.badge}</p>
      <div slot="actions" class="vf-actions">
        <p id="vf-label" class="sr-only">{v.countdownLabel}</p>
        <div class="vf-count" role="timer" aria-labelledby="vf-label" data-countdown data-target={VERIFACTU_DATE}>
          {
            units.map((u) => (
              <div class="vf-unit">
                <span class="vf-num t-display tnum" data-unit={u.key}>
                  {u.value}
                </span>
                <span class="vf-lab">{u.label}</span>
              </div>
            ))
          }
        </div>
        <p class="vf-arrived hidden font-medium text-mint">{v.arrived}</p>
        <button type="button" class="btn btn-secondary world-only" data-action="tamper">{a.tamper}</button>
        <p class="tamper-msg sr-only" role="status" aria-live="polite" data-tamper-msg data-text={a.tamperNo}></p>
      </div>
    </Chapter>
  </div>
</section>

<style>
  .vf-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .vf-count {
    display: flex;
    gap: 1.4rem;
  }
  .vf-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .vf-num {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.8rem);
    line-height: 1;
  }
  .vf-lab {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    color: var(--color-muted-dark);
  }
  [data-countdown][data-arrived] ~ .vf-arrived {
    display: block;
  }
  .vf-num:global(.tick) {
    animation: tick 0.5s var(--ease-out-expo);
  }
  @keyframes tick {
    from {
      transform: translateY(-20%);
      opacity: 0.2;
    }
  }
</style>
