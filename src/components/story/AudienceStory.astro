---
import Chapter from '../Chapter.astro';
import es from '../../content/es';
import { CH } from '../../scripts/world/chapters';

const a = es.audience;
const st = es.story.steps.audience;
const act = es.story.actions;
const sectorsSentence =
  a.sectors.map((x, i) => (i === 0 ? x : x.toLowerCase())).slice(0, -1).join(', ') + ' y ' + a.sectors[a.sectors.length - 1].toLowerCase() + '.';
---

<section id="para-quien" class="story" aria-labelledby="audiencia-title">
  <div class="container-x">
    <Chapter index={CH.audience} kicker={st.kicker} title={a.title} caption={st.caption} level={2} titleId="audiencia-title">
      <p>{a.text}</p>
      {
        a.segments.map((seg) => (
          <div class="segment mt-6">
            <p class="text-[0.9375rem] font-medium text-green">
              {seg.name} · <span class="tnum">{seg.range}</span>
            </p>
            <p class="t-display mt-2 text-[1.45rem] leading-tight">{seg.headline}</p>
            <p class="mt-3">{seg.text}</p>
            <p class="mt-4 rounded-lg bg-paper-2 p-3 text-sm">
              <span class="tag mr-1.5 align-[1px]">{a.exampleTag}</span>
              <strong>{seg.example.name}.</strong> <span class="text-muted">{seg.example.text}</span>
            </p>
          </div>
        ))
      }
      <p class="mt-6 text-[0.9375rem] text-muted">
        <span class="font-medium text-green">{a.sectorsTitle}:</span>
        {sectorsSentence}
      </p>
      <div slot="actions" class="size-toggle world-only" role="group" aria-label={act.sizeLegend}>
        <button type="button" class="size-btn" data-size="small" aria-pressed="true">{act.sizeSmall}</button>
        <button type="button" class="size-btn" data-size="medium" aria-pressed="false">{act.sizeMedium}</button>
      </div>
    </Chapter>
  </div>
</section>

<style>
  .size-toggle {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    background: rgb(20 32 27 / 0.07);
    backdrop-filter: blur(8px);
  }
  .size-btn {
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .size-btn[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
</style>
