---
import SectionHead from '../SectionHead.astro';
import Chapter from '../Chapter.astro';
import ProblemMock from '../ProblemMock.astro';
import es from '../../content/es';
import { CH } from '../../scripts/world/chapters';

const p = es.problem;
const s = es.story;
---

<section id="problema" class="section story" aria-labelledby="problema-title">
  <div class="container-x">
    <div class="story-intro">
      <SectionHead name={p.eyebrow} title={p.title} id="problema-title" intro={p.intro} />
    </div>

    <Chapter index={CH.typing} kicker={`${s.today} · 1/3`} title={p.cards[0].title}>
      <p>{p.cards[0].text}</p>
      <ProblemMock slot="fallback" kind="sheet" />
    </Chapter>

    <Chapter index={CH.overdue} kicker={`${s.today} · 2/3`} title={p.cards[1].title}>
      <p>{p.cards[1].text}</p>
      <ProblemMock slot="fallback" kind="inbox" />
    </Chapter>

    <Chapter index={CH.fog} kicker={`${s.today} · 3/3`} title={p.cards[2].title}>
      <p>{p.cards[2].text}</p>
      <ProblemMock slot="fallback" kind="fog" />
    </Chapter>

    <Chapter index={CH.cause} title={p.conclusion} class="ch-statement">
      <p>{p.conclusionText}</p>
    </Chapter>
  </div>
</section>
