---
import Chapter from '../Chapter.astro';
import ProblemMock from '../ProblemMock.astro';
import es from '../../content/es';
import { CH } from '../../scripts/world/chapters';

const p = es.problem;
const st = es.story.steps;
---

<section id="problema" class="story" aria-labelledby="problema-title">
  <div class="container-x">
    <Chapter index={CH.meet} kicker={st.meet.kicker} title={st.meet.title} caption={st.meet.caption} level={2} titleId="problema-title">
      <p class="ch-detail-kicker">{p.title}</p>
      <p>{p.intro}</p>
    </Chapter>

    <Chapter index={CH.typing} kicker={st.typing.kicker} title={st.typing.title} caption={st.typing.caption}>
      <p class="ch-detail-kicker">{p.cards[0].title}</p>
      <p>{p.cards[0].text}</p>
      <ProblemMock slot="fallback" kind="sheet" />
    </Chapter>

    <Chapter index={CH.overdue} kicker={st.overdue.kicker} title={st.overdue.title} caption={st.overdue.caption}>
      <p class="ch-detail-kicker">{p.cards[1].title}</p>
      <p>{p.cards[1].text}</p>
      <ProblemMock slot="fallback" kind="inbox" />
    </Chapter>

    <Chapter index={CH.fog} kicker={st.fog.kicker} title={st.fog.title} caption={st.fog.caption}>
      <p class="ch-detail-kicker">{p.cards[2].title}</p>
      <p>{p.cards[2].text}</p>
      <ProblemMock slot="fallback" kind="fog" />
    </Chapter>

    <Chapter index={CH.cause} kicker={st.cause.kicker} title={st.cause.title} caption={st.cause.caption} class="ch-statement">
      <p class="ch-detail-kicker">{p.conclusion}</p>
      <p>{p.conclusionText}</p>
    </Chapter>
  </div>
</section>
