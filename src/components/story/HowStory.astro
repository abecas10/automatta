---
import Chapter from '../Chapter.astro';
import Dashboard from '../Dashboard.astro';
import Payables from '../demos/Payables.astro';
import Receivables from '../demos/Receivables.astro';
import Treasury from '../demos/Treasury.astro';
import Close from '../demos/Close.astro';
import Taxes from '../demos/Taxes.astro';
import es from '../../content/es';
import { CH } from '../../scripts/world/chapters';

const h = es.how;
const st = es.story.steps;
const a = es.story.actions;
const piece = (id: string) => h.pieces.find((p) => p.id === id)!;
// Orden de la historia: F-2041 se lee, se cobra, se cuadra, se archiva y declara su IVA;
// después, lo mismo con las facturas que pagas.
const chapters = [
  { id: 'cobros', index: CH.cobros, Demo: Receivables },
  { id: 'tesoreria', index: CH.tesoreria, Demo: Treasury },
  { id: 'cierre', index: CH.cierre, Demo: Close },
  { id: 'impuestos', index: CH.impuestos, Demo: Taxes },
  { id: 'proveedores', index: CH.proveedores, Demo: Payables },
] as const;
---

<section id="como-funciona" class="story" aria-labelledby="como-title">
  <div class="container-x">
    <Chapter index={CH.automatta} kicker={st.automatta.kicker} title={st.automatta.title} caption={st.automatta.caption} level={2} titleId="como-title">
      <p>{h.intro}</p>
      <div slot="fallback"><Dashboard /></div>
    </Chapter>

    <Chapter index={CH.read} kicker={st.read.kicker} title={st.read.title} caption={st.read.caption}>
      <p>{es.how.pieces[0].text}</p>
    </Chapter>

    {
      chapters.map(({ id, index, Demo }) => {
        const p = piece(id);
        const s = st[id];
        return (
          <Chapter index={index} id={id} titleId={`${id}-title`} kicker={s.kicker} title={s.title} caption={s.caption}>
            <p class="ch-detail-kicker">{p.title}</p>
            <p>{p.text}</p>
            <ul class="ch-points">
              {p.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
            {id === 'tesoreria' && (
              <button slot="actions" type="button" class="btn btn-primary world-only" data-action="stamp" data-done={a.stamped}>
                {a.stamp}
              </button>
            )}
            {id === 'proveedores' && (
              <button slot="actions" type="button" class="btn btn-primary world-only" data-action="approve" data-done={a.approved}>
                {a.approve}
              </button>
            )}
            <div slot="fallback" class="window">
              <div class="window-bar">
                <span class="font-medium text-ink">{p.title}</span>
                <span class="tag">{h.tag}</span>
              </div>
              <div class="p-5 sm:p-7">
                <Demo />
              </div>
            </div>
          </Chapter>
        );
      })
    }

    <p class="story-note">
      <svg class="mt-1 h-4 w-4 shrink-0 text-ink" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6.75" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M8 7.2v4M8 4.8v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <span>{h.excluded}</span>
    </p>
  </div>
</section>
