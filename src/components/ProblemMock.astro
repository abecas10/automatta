---
// Mini ilustraciones del problema (solo sin 3D).
interface Props {
  kind: 'sheet' | 'inbox' | 'fog';
}
const { kind } = Astro.props;
import es from '../content/es';

const p = es.problem;
// Celdas del "Excel" tecleado a mano: r = error (#N/A), ? = dato dudoso.
const sheetRows = [
  ['P-118', '1.210', 'r', '?'],
  ['P-117', '860', 'r', 'r'],
  ['P-116', '2.420', '', '?'],
  ['P-115', '395', 'r', ''],
  ['P-114', '1.150', '', 'r'],
  ['P-113', '640', 'r', '?'],
];
---

{kind === 'sheet' && (
  <div class="problem-mock desk-surface relative h-64 overflow-hidden p-4" aria-hidden="true" data-sheet>
    <div class="doc overflow-hidden !rounded-md">
      <div class="t-data flex items-center gap-2 bg-[#1D6F42] px-3 py-1.5 text-[11px] font-medium text-white">
        <span class="grid h-3.5 w-3.5 place-items-center rounded-sm bg-white/90 text-[8px] font-bold text-[#1D6F42]">X</span>
        {p.sheet.title}
      </div>
      <table class="t-data tnum w-full border-collapse text-[11px]">
        <thead>
          <tr class="bg-paper-2 text-muted">
            {p.sheet.columns.map((c, i) => (
              <th class:list={['border border-line px-1.5 py-1 font-medium', i === 0 ? 'text-left' : i === 1 ? 'text-right' : '']}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {
            sheetRows.map((row) => (
              <tr>
                <td class="border border-line px-1.5 py-[5px]">{row[0]}</td>
                <td class="border border-line px-1.5 py-[5px] text-right">{row[1]}</td>
                {row.slice(2).map((c) => (
                  <td class:list={['sheet-cell border border-line px-1.5 py-[5px] text-center', c && 'is-bad']} data-bad={c ? '' : undefined}>
                    {c === '?' ? '¿?' : c === 'r' ? '#N/A' : ''}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
)}
{kind === 'inbox' && (
  <div class="problem-mock desk-surface relative h-64 overflow-hidden p-4" aria-hidden="true" data-inbox>
    <div class="doc flex items-center justify-between !rounded-md px-3 py-2 text-[12px] font-medium">
      <span>{p.inbox.title}</span>
      <span class="tnum rounded-full bg-red px-2 py-0.5 text-[11px] text-white" data-inbox-count aria-label={`${p.inbox.items.length} ${p.inbox.unread}`}>{p.inbox.items.length}</span>
    </div>
    <ul class="relative mt-2 flex flex-col gap-1.5">
      {
        p.inbox.items.map((name, i) => (
          <li class="inbox-item doc flex items-center gap-2 !rounded-md px-2.5 py-2" style={`--i:${i}`}>
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red" />
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[12px] font-medium">{p.inbox.subject}</span>
              <span class="t-data block truncate text-[11px] text-muted">{name}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
)}
{kind === 'fog' && (
  <div class="problem-mock desk-surface relative h-64 overflow-hidden p-4" aria-hidden="true" data-fog>
    <div class="doc relative h-full !rounded-md p-3">
      <div class="flex items-center justify-between text-[12px] font-medium">
        <span>{p.fog.title}</span> <span class="text-muted">{p.fog.question}</span>
      </div>
      <svg viewBox="0 0 240 150" class="mt-2 h-[calc(100%-1.5rem)] w-full" preserveAspectRatio="none">
        <path d="M0 40 H240 M0 80 H240 M0 120 H240" stroke="#14201B" stroke-opacity=".07" />
        <path class="fog-line" d="M0 90 C 30 70, 50 100, 80 80 S 110 60, 120 75" fill="none" stroke="#14201B" stroke-width="2.5" stroke-linecap="round" />
        <path class="fog-guess" d="M120 75 C 150 95, 165 40, 190 70 S 220 130, 240 110" fill="none" stroke="#C8372D" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round" />
        <path class="fog-guess" d="M120 75 C 150 50, 170 30, 200 45 S 225 30, 240 20" fill="none" stroke="#1F6B4A" stroke-opacity=".7" stroke-width="2" stroke-dasharray="5 6" stroke-linecap="round" />
        <line x1="120" y1="0" x2="120" y2="150" stroke="#14201B" stroke-opacity=".3" stroke-dasharray="2 4" />
      </svg>
      <div class="fog absolute inset-y-3 right-3 left-1/2 rounded-r-md" />
      <span class="fog-q t-display absolute top-1/2 left-[72%] -translate-x-1/2 -translate-y-1/2 text-6xl text-ink/80">?</span>
    </div>
  </div>
)}

<style>
  .sheet-cell.is-bad {
    color: var(--color-red);
    font-weight: 600;
  }
  :global(.js-motion) .sheet-cell.is-bad {
    color: transparent;
  }
  .fog {
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(245 246 243 / 0.9) 40%);
    backdrop-filter: blur(3px);
  }
</style>
