---
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';
import es from '../../content/es';
import { SURVEY_URL, MAILTO_CALL, CONTACT_EMAIL } from '../../config';

const s = es.survey;
---

<section id="encuesta" class="section" aria-labelledby="encuesta-title">
  <div class="container-x">
    <SectionHead name={s.eyebrow} title={s.title} id="encuesta-title" intro={s.text} />

    <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5 lg:col-start-4">
        <p class="h-sub max-w-[22ch]" data-rise>{s.program.title}</p>
        <p class="mt-4 max-w-[46ch] text-muted">{s.program.text}</p>
        <div class="mt-10 flex flex-col items-start gap-4">
          <Button href={SURVEY_URL} external size="lg">{s.cta}</Button>
          <p class="text-muted">
            {s.altPrefix}
            <a href={MAILTO_CALL} class="link text-ink">{s.altLink}</a>
            <span class="block text-sm text-muted">{CONTACT_EMAIL}</span>
          </p>
        </div>
      </div>

      <!-- La encuesta, como documento -->
      <div class="lg:col-span-4 lg:col-start-9" data-survey-doc>
        <div class="doc p-6 sm:p-7" data-reveal>
          <p class="text-sm font-medium">{s.docTitle}</p>
          <ul class="mt-5 flex flex-col divide-y divide-line">
            {
              s.bullets.map((b) => (
                <li class="sv-item flex items-start gap-3.5 py-4 first:pt-0 last:pb-0">
                  <span class="sv-box mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-[5px] border border-ink/30" aria-hidden="true">
                    <svg class="sv-tick h-3 w-3" viewBox="0 0 12 12" fill="none">
                      <path d="M2.5 6.5l2.3 2.3L9.5 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span>
                    <span class="block font-medium">{b.title}</span>
                    <span class="block text-[0.9375rem] text-muted">{b.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sv-box {
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .sv-tick {
    color: var(--color-paper);
  }
  .sv-item.is-checked .sv-box {
    background: var(--color-green);
    border-color: var(--color-green);
  }
  :global(:root:not(.js-motion)) .sv-box {
    background: var(--color-green);
    border-color: var(--color-green);
  }
</style>
