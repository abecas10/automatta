---
import Logo from '../Logo.astro';
import Button from '../Button.astro';
import es from '../../content/es';
import { SURVEY_URL, MAILTO, CONTACT_EMAIL } from '../../config';

interface Props {
  showCta?: boolean;
}
const { showCta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="dark bg-ink text-paper">
  {
    showCta && (
      <div class="container-x py-24 sm:py-32">
        <div class="grid gap-8 lg:grid-cols-12">
          <h2 class="h-section max-w-[20ch] lg:col-span-8" data-rise>
            {es.finalCta.title}
          </h2>
          <div class="flex items-end lg:col-span-4 lg:justify-end">
            <Button href={SURVEY_URL} external size="lg">
              {es.finalCta.cta}
            </Button>
          </div>
        </div>
      </div>
    )
  }

  <div class="container-x">
    <div class="grid gap-10 border-t border-line-dark py-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="inline-block rounded-md" aria-label="Automatta, inicio"><Logo tone="light" class="text-[17px]" /></a>
        <p class="mt-4 max-w-[30ch] text-paper/65">{es.footer.tagline}</p>
      </div>
      <div class="md:col-span-3">
        <p class="text-sm text-muted-dark">{es.footer.contact}</p>
        <a href={MAILTO} class="link mt-1 inline-block text-paper decoration-paper/30">{CONTACT_EMAIL}</a>
      </div>
      <nav aria-label="Legal" class="flex flex-col gap-1 md:col-span-4 md:items-end">
        <a href="/aviso-legal" class="text-paper/70 hover:text-paper">{es.footer.legal}</a>
        <a href="/privacidad" class="text-paper/70 hover:text-paper">{es.footer.privacy}</a>
      </nav>
    </div>
    <div class="border-t border-line-dark py-6 text-sm text-paper/55">
      <p>© {year} Automatta. {es.footer.made}.</p>
    </div>
  </div>
</footer>
