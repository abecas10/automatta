---
import SectionHead from '../SectionHead.astro';
import es from '../../content/es';

const f = es.faq;
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container-x">
    <SectionHead name={f.eyebrow} title={f.title} id="faq-title" />

    <div class="mt-12 grid lg:mt-16 lg:grid-cols-12 lg:gap-8">
      <div class="border-t border-line lg:col-span-9 lg:col-start-4">
        {
          f.items.map((item, i) => (
            <div class="faq-item border-b border-line" data-faq-item>
              <h3>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-6 py-5 text-left text-[1.125rem] font-medium sm:text-[1.25rem]"
                  aria-expanded="false"
                  aria-controls={`faq-panel-${i}`}
                  id={`faq-button-${i}`}
                  data-faq-button
                >
                  {item.q}
                  <span class="faq-icon relative grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink/20" aria-hidden="true">
                    <span class="absolute h-px w-3 bg-ink" />
                    <span class="faq-v absolute h-3 w-px bg-ink" />
                  </span>
                </button>
              </h3>
              <div id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-button-${i}`} class="faq-panel">
                <div class="overflow-hidden">
                  <p class="max-w-[62ch] pb-6 text-muted">{item.a}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s var(--ease-out-quart),
      visibility 0s linear 0.45s;
  }
  [data-open] .faq-panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.45s var(--ease-out-quart),
      visibility 0s;
  }
  .faq-icon {
    transition:
      transform 0.45s var(--ease-out-quart),
      background-color 0.3s,
      border-color 0.3s;
  }
  .faq-v {
    transition: transform 0.45s var(--ease-out-quart);
  }
  [data-open] .faq-icon {
    transform: rotate(90deg);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }
  [data-open] .faq-icon span {
    background: var(--color-paper);
  }
  [data-open] .faq-v {
    transform: scaleY(0);
  }
  .faq-item button:hover .faq-icon {
    border-color: var(--color-ink);
  }
</style>
