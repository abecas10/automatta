---
import es from '../../content/es';

const f = es.faq;
---

<section id="faq" class="relative bg-paper-2 py-24 sm:py-32" aria-labelledby="faq-title">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow text-violet" data-reveal>{f.eyebrow}</p>
      <h2 id="faq-title" class="h-section mt-5" data-split>{f.title}</h2>
    </div>

    <div class="flex flex-col gap-3">
      {
        f.items.map((item, i) => (
          <div class="faq-item rounded-2xl border border-ink/8 bg-white" data-faq-item data-reveal>
            <h3>
              <button
                type="button"
                class="flex w-full items-center justify-between gap-6 rounded-2xl px-5 py-5 text-left font-display text-lg font-semibold sm:px-7 sm:text-xl"
                aria-expanded="false"
                aria-controls={`faq-panel-${i}`}
                id={`faq-button-${i}`}
                data-faq-button
              >
                {item.q}
                <span class="faq-icon relative grid h-8 w-8 shrink-0 place-items-center rounded-full bg-paper-2" aria-hidden="true">
                  <span class="absolute h-0.5 w-3.5 rounded bg-ink" />
                  <span class="faq-v absolute h-3.5 w-0.5 rounded bg-ink" />
                </span>
              </button>
            </h3>
            <div id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-button-${i}`} class="faq-panel">
              <div class="overflow-hidden">
                <p class="px-5 pb-6 text-muted sm:px-7 sm:text-lg">{item.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.5s var(--ease-out-expo),
      visibility 0s linear 0.5s;
  }
  [data-open] .faq-panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.5s var(--ease-out-expo),
      visibility 0s;
  }
  .faq-icon {
    transition:
      transform 0.5s var(--ease-out-expo),
      background-color 0.3s;
  }
  .faq-v {
    transition: transform 0.5s var(--ease-out-expo);
  }
  [data-open] .faq-icon {
    transform: rotate(180deg);
    background: var(--color-money);
  }
  [data-open] .faq-v {
    transform: scaleY(0);
  }
  .faq-item {
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .faq-item:hover,
  .faq-item[data-open] {
    border-color: rgb(108 92 231 / 0.3);
    box-shadow: 0 12px 30px -16px rgb(11 16 32 / 0.25);
  }
</style>
