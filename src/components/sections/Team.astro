---
import SectionHead from '../SectionHead.astro';
import Avatar from '../Avatar.astro';
import es from '../../content/es';

const t = es.team;
// Cuando tengáis fotos: import fotoAC from '../../assets/alex-castella.jpg';
// y pasad photo={fotoAC} al <Avatar /> correspondiente.
---

<section id="equipo" class="section" aria-labelledby="equipo-title">
  <div class="container-x">
    <SectionHead name={t.eyebrow} title={t.title} id="equipo-title" intro={t.text} />

    <div class="mt-14 grid lg:mt-20 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-9 lg:col-start-4">
        <ul class="grid max-w-2xl grid-cols-2 gap-5 sm:gap-8">
          {
            t.founders.map((f) => (
              <li>
                <Avatar initials={f.initials} name={f.name} />
                <p class="mt-4 text-[1.125rem] font-medium">{f.name}</p>
                <p class="text-muted">{f.role}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-10 inline-flex items-center gap-2 text-muted">
          <svg class="h-4 w-4 text-green" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0a5.5 5.5 0 00-5.5 5.5C2.5 9.6 8 16 8 16s5.5-6.4 5.5-10.5A5.5 5.5 0 008 0zm0 7.5a2 2 0 110-4 2 2 0 010 4z"></path>
          </svg>
          {t.place}
        </p>
      </div>
    </div>
  </div>
</section>
