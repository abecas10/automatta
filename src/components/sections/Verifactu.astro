---
import SectionHead from '../SectionHead.astro';
import es from '../../content/es';
import { VERIFACTU_DATE } from '../../config';

const v = es.verifactu;
// Valor inicial calculado en el build; el JS lo actualiza al cargar.
const diff = Math.max(0, new Date(VERIFACTU_DATE).getTime() - Date.now());
const s = Math.floor(diff / 1000);
const pad = (n: number) => String(n).padStart(2, '0');
const units = [
  { key: 'days', value: String(Math.floor(s / 86400)), label: v.units.days },
  { key: 'hours', value: pad(Math.floor((s % 86400) / 3600)), label: v.units.hours },
  { key: 'minutes', value: pad(Math.floor((s % 3600) / 60)), label: v.units.minutes },
  { key: 'seconds', value: pad(s % 60), label: v.units.seconds },
];
---

<section id="verifactu" class="section dark bg-ink text-paper" aria-labelledby="verifactu-title">
  <div class="container-x">
    <SectionHead name={v.eyebrow} title={v.title} id="verifactu-title">
      <p class="mt-8 text-sm text-muted-dark" id="vf-label">{v.countdownLabel}</p>
      <div class="mt-3 flex flex-wrap gap-x-8 gap-y-4 sm:gap-x-12" role="timer" aria-labelledby="vf-label" data-countdown data-target={VERIFACTU_DATE}>
        {
          units.map((u) => (
            <div class="vf-unit">
              <span class="vf-num t-display tnum block text-[clamp(3rem,2rem+6vw,7rem)] leading-none" data-unit={u.key}>
                {u.value}
              </span>
              <span class="t-data mt-2 block text-sm text-muted-dark">{u.label}</span>
            </div>
          ))
        }
      </div>
      <p class="vf-arrived mt-5 hidden font-medium text-mint">{v.arrived}</p>

      <div class="mt-12 grid gap-8 border-t border-line-dark pt-10 md:grid-cols-2 md:gap-10">
        <p class="text-paper/80">{v.text}</p>
        <p class="text-paper/80">{v.why}</p>
      </div>

      <blockquote class="h-sub mt-12 max-w-[26ch]" data-rise>{v.quote}</blockquote>
      <p class="mt-8 inline-flex items-center gap-3 text-mint">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 2l6 2.5v5c0 4-2.7 7-6 8.5C6.7 16.5 4 13.5 4 9.5v-5L10 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
          <path d="M7 10l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>{v.badge}</span>
      </p>
    </SectionHead>
  </div>
</section>

<style>
  [data-countdown][data-arrived] ~ .vf-arrived {
    display: block;
  }
  .vf-num:global(.tick) {
    animation: tick 0.5s var(--ease-out-expo);
  }
  @keyframes tick {
    from {
      transform: translateY(-20%);
      opacity: 0.2;
    }
  }
</style>
