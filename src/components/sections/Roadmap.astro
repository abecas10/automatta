---
import es from '../../content/es';

const r = es.roadmap;
---

<section id="hoja-de-ruta" class="relative overflow-x-clip bg-paper py-24 sm:py-32" aria-labelledby="ruta-title">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow text-violet" data-reveal>{r.eyebrow}</p>
      <h2 id="ruta-title" class="h-section mt-5" data-split>{r.title}</h2>
    </div>

    <ol class="relative" data-roadmap>
      <!-- Línea base y línea de progreso que se dibuja con el scroll -->
      <span class="absolute top-2 bottom-2 left-[11px] w-0.5 rounded bg-ink/10" aria-hidden="true"></span>
      <span class="rm-line absolute top-2 bottom-2 left-[11px] w-0.5 origin-top rounded bg-gradient-to-b from-money to-violet" aria-hidden="true"
      ></span>
      {
        r.items.map((item) => (
          <li class="rm-item relative pb-10 pl-12 last:pb-0">
            <span
              class:list={[
                'rm-dot absolute top-1 left-0 grid h-6 w-6 place-items-center rounded-full border-2',
                item.current ? 'border-money bg-money' : 'border-ink/20 bg-paper',
              ]}
              aria-hidden="true"
            >
              {item.current && <span class="rm-pulse absolute inset-0 rounded-full bg-money" />}
              <span class:list={['relative h-2 w-2 rounded-full', item.current ? 'bg-ink' : 'bg-ink/30']} />
            </span>
            <div class="flex flex-wrap items-center gap-3">
              <p class="tnum font-display text-sm font-bold text-violet">{item.when}</p>
              {item.current && (
                <span class="rounded-full bg-money px-2.5 py-0.5 text-xs font-bold text-ink">{r.here}</span>
              )}
            </div>
            <h3 class="mt-1 font-display text-2xl font-bold sm:text-3xl">{item.title}</h3>
            <p class="mt-2 max-w-lg text-lg text-muted">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rm-pulse {
    animation: rm-pulse 1.8s ease-out infinite;
  }
  @keyframes rm-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
