---
import SectionHead from '../SectionHead.astro';
import es from '../../content/es';

const r = es.roadmap;
---

<section id="hoja-de-ruta" class="section" aria-labelledby="ruta-title">
  <div class="container-x">
    <SectionHead name={r.eyebrow} title={r.title} id="ruta-title" />

    <ol class="rm relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6 lg:mt-20" data-roadmap>
      <!-- Línea base y línea de progreso que se dibuja con el scroll -->
      <span class="rm-track" aria-hidden="true"></span>
      <span class="rm-line" aria-hidden="true"></span>
      {
        r.items.map((item) => (
          <li class="rm-item relative pl-9 md:pt-9 md:pl-0">
            <span class:list={['rm-dot absolute top-0.5 left-0 grid h-5 w-5 place-items-center rounded-full border md:top-0 md:left-0', item.current ? 'border-green bg-green' : 'border-ink/25 bg-paper']} aria-hidden="true">
              {item.current && <span class="rm-pulse absolute inset-0 rounded-full bg-green" />}
              <span class:list={['relative h-1.5 w-1.5 rounded-full', item.current ? 'bg-paper' : 'bg-ink/30']} />
            </span>
            <div class="flex flex-wrap items-center gap-3">
              <p class="tnum text-[0.9375rem] font-medium text-green">{item.when}</p>
              {item.current && <span class="pill pill-green">{r.here}</span>}
            </div>
            <h3 class="mt-2 text-[1.375rem]">{item.title}</h3>
            <p class="mt-2 max-w-[32ch] text-muted">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rm {
    --p: 0;
  }
  .rm-track,
  .rm-line {
    position: absolute;
    left: 9px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--color-line);
  }
  .rm-line {
    background: var(--color-green);
    transform: scaleY(var(--p));
    transform-origin: top;
  }
  @media (min-width: 768px) {
    .rm-track,
    .rm-line {
      left: 0;
      right: 0;
      top: 9px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .rm-line {
      transform: scaleX(var(--p));
      transform-origin: left;
    }
  }
  :global(:root:not(.js-motion)) .rm {
    --p: 0.25;
  }
  .rm-pulse {
    animation: rm-pulse 2s ease-out infinite;
  }
  @keyframes rm-pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
</style>
