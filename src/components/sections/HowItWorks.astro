---
import SectionHead from '../SectionHead.astro';
import es from '../../content/es';
import Payables from '../demos/Payables.astro';
import Receivables from '../demos/Receivables.astro';
import Treasury from '../demos/Treasury.astro';
import Close from '../demos/Close.astro';
import Taxes from '../demos/Taxes.astro';

const h = es.how;
const demos = {
  proveedores: Payables,
  cobros: Receivables,
  tesoreria: Treasury,
  cierre: Close,
  impuestos: Taxes,
} as const;
---

<section id="como-funciona" class="section" aria-labelledby="como-title">
  <div class="container-x">
    <SectionHead name={h.eyebrow} title={h.title} id="como-title" intro={h.intro}>
      <!-- Índice de módulos -->
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2">
        {
          h.pieces.map((piece) => (
            <li>
              <a href={`#${piece.id}`} class="link text-[0.9375rem]" class:list={[piece.start && 'text-green']}>
                {piece.title}
              </a>
            </li>
          ))
        }
      </ul>
    </SectionHead>

    <div class="mt-16 flex flex-col gap-20 sm:mt-24 sm:gap-28">
      {
        h.pieces.map((piece) => {
          const Demo = demos[piece.id];
          return (
            <article id={piece.id} class="grid items-center gap-8 lg:grid-cols-12 lg:gap-8" aria-labelledby={`${piece.id}-title`} data-piece={piece.id}>
              <div class="max-w-[44ch] lg:col-span-5">
                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-[0.9375rem] font-medium text-green">{piece.kicker}</p>
                  {piece.start && <span class="pill pill-green">{h.startHere}</span>}
                </div>
                <h3 id={`${piece.id}-title`} class="h-sub mt-3" data-rise>
                  {piece.title}
                </h3>
                <p class="mt-4 text-muted">{piece.text}</p>
                <ul class="mt-6 flex flex-col gap-2">
                  {piece.points.map((pt) => (
                    <li class="flex items-center gap-3 text-[0.9375rem] font-medium">
                      <svg class="h-4 w-4 shrink-0 text-green" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {pt}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="window lg:col-span-7" aria-hidden="true" data-demo={piece.id} data-reveal>
                <div class="window-bar">
                  <span class="font-medium text-ink">{piece.title}</span>
                  <span class="tag">{h.tag}</span>
                </div>
                <div class="p-5 sm:p-7">
                  <Demo />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="mt-20 grid lg:grid-cols-12 lg:gap-8 sm:mt-24">
      <p class="flex items-start gap-3 border-t border-line pt-6 text-muted lg:col-span-9 lg:col-start-4">
        <svg class="mt-1 h-4 w-4 shrink-0 text-ink" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6.75" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 7.2v4M8 4.8v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span>{h.excluded}</span>
      </p>
    </div>
  </div>
</section>
