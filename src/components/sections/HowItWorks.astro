---
import es from '../../content/es';

const h = es.how;
const c = h.demoCobros;
const r = h.demoRecon;
const f = h.demoForecast;

// Previsión: caja semanal (valores ficticios, en miles). Semana 6 es la ajustada.
const cash = [30, 34, 31, 36, 26, 14, 24, 35];
const max = 40;
const W = 400;
const H = 240;
const pad = { l: 16, r: 16, t: 52, b: 28 };
const bw = (W - pad.l - pad.r) / cash.length;
const yOf = (v: number) => pad.t + (H - pad.t - pad.b) * (1 - v / max);
const pts = cash.map((v, i) => [pad.l + bw * i + bw / 2, yOf(v)] as const);
const linePath = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const threshold = yOf(18);
---

<section id="como-funciona" class="relative bg-paper py-24 sm:py-32" aria-labelledby="como-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow text-violet" data-reveal>{h.eyebrow}</p>
      <h2 id="como-title" class="h-section mt-5" data-split>{h.title}</h2>
      <p class="mt-6 text-lg text-muted sm:text-xl" data-reveal>{h.intro}</p>
    </div>

    <div class="mt-16 flex flex-col gap-20 sm:mt-24 sm:gap-32">
      {
        h.pieces.map((piece, idx) => (
          <article
            id={piece.id}
            class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16"
            aria-labelledby={`${piece.id}-title`}
            data-piece={piece.id}
          >
            <div class:list={['max-w-lg', idx % 2 === 1 && 'lg:order-2 lg:justify-self-end']}>
              <p class="tnum font-display text-sm font-bold text-violet" data-reveal>
                {piece.number}
              </p>
              <h3 id={`${piece.id}-title`} class="mt-2 font-display text-3xl font-bold sm:text-4xl" data-reveal>
                {piece.title}
              </h3>
              <p class="mt-4 text-lg text-muted" data-reveal>
                {piece.text}
              </p>
              <ul class="mt-6 flex flex-col gap-2.5" data-reveal>
                {piece.points.map((pt) => (
                  <li class="flex items-center gap-3 font-medium">
                    <svg class="h-5 w-5 shrink-0 text-money-dark" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <circle cx="10" cy="10" r="9" fill="currentColor" opacity=".14" />
                      <path d="M6 10.5l2.5 2.5L14 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {pt}
                  </li>
                ))}
              </ul>
            </div>

            <div class="demo card-surface relative overflow-hidden p-5 sm:p-7" aria-hidden="true" data-demo={piece.id}>
              <span class="tag-illus absolute top-4 right-4 border-black/10 text-muted">{h.tag}</span>

              {piece.id === 'cobros' && (
                <div class="pt-8" data-cobros>
                  <div class="rounded-xl border border-black/8 bg-paper p-4">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="text-xs text-muted">{c.invoice}</p>
                        <p class="mt-0.5 font-semibold">{c.client}</p>
                      </div>
                      <p class="tnum font-display text-2xl font-bold">{c.amount}</p>
                    </div>
                    <div class="relative mt-4 h-7">
                      <span class="cb-pill cb-pill-0 absolute left-0 rounded-full bg-alert/15 px-3 py-1 text-xs font-semibold text-alert-dark">
                        {c.states[0]}
                      </span>
                      <span class="cb-pill cb-pill-1 absolute left-0 rounded-full bg-violet/15 px-3 py-1 text-xs font-semibold text-violet">
                        {c.states[1]}
                      </span>
                      <span class="cb-pill cb-pill-2 absolute left-0 rounded-full bg-money/20 px-3 py-1 text-xs font-semibold text-money-dark">
                        {c.states[2]}
                      </span>
                    </div>
                  </div>

                  <ol class="relative mt-6 grid grid-cols-3 gap-2">
                    <span class="absolute top-[13px] right-[16%] left-[16%] h-0.5 bg-black/8" />
                    <span class="cb-progress absolute top-[13px] right-[16%] left-[16%] h-0.5 origin-left bg-money" />
                    {c.states.map((s, i) => (
                      <li class="cb-node relative flex flex-col items-center gap-2 text-center" data-i={i}>
                        <span
                          class:list={[
                            'cb-dot grid h-7 w-7 place-items-center rounded-full border-2 bg-white text-[11px] font-bold',
                            i === 0 ? 'border-alert text-alert-dark' : i === 1 ? 'border-violet text-violet' : 'border-money text-money-dark',
                          ]}
                        >
                          {i + 1}
                        </span>
                        <span class="text-xs font-medium text-muted">{s}</span>
                      </li>
                    ))}
                  </ol>

                  <div class="mt-6 flex items-center gap-4">
                    <div class="cb-mail flex items-center gap-2 rounded-lg border border-black/8 bg-white px-3 py-2 text-xs shadow-sm">
                      <svg class="h-4 w-4 text-violet" viewBox="0 0 16 16" fill="none">
                        <path d="M1.5 7.5L14.5 2l-4 12-3-5-6-1.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                      </svg>
                      <span>Recordatorio para {c.client}</span>
                    </div>
                    <svg class="cb-check ml-auto h-14 w-14 shrink-0" viewBox="0 0 56 56" fill="none">
                      <circle class="cb-check-circle" cx="28" cy="28" r="25" stroke="#2BD67B" stroke-width="3" />
                      <path class="cb-check-mark" d="M17 29l7.5 7.5L40 21" stroke="#0B7A40" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </div>
                </div>
              )}

              {piece.id === 'conciliacion' && (
                <div class="pt-8" data-recon>
                  <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] gap-x-2 text-[11px] font-semibold tracking-wide text-muted uppercase sm:gap-x-3">
                    <span>{r.bankTitle}</span>
                    <span />
                    <span>{r.invoicesTitle}</span>
                  </div>
                  <ul class="mt-3 flex flex-col gap-3">
                    {r.pairs.map((p, i) => (
                      <li class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-x-2 sm:gap-x-3" data-i={i}>
                        <div class="rc-bank relative rounded-xl border border-black/8 bg-ink px-3 py-2.5 text-paper shadow-md">
                          <p class="truncate text-[11px] text-paper/70">{p.bank}</p>
                          <p class="tnum font-semibold">+{p.amount}</p>
                        </div>
                        <div class="relative flex w-8 items-center justify-center sm:w-12">
                          <span class="rc-link absolute inset-x-0 top-1/2 h-0.5 origin-left -translate-y-1/2 bg-money" />
                          <span class="rc-check relative grid h-6 w-6 place-items-center rounded-full bg-money text-ink">
                            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none">
                              <path d="M3.5 8.5l3 3L12.5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        </div>
                        <div class="rc-invoice rounded-xl border border-black/8 bg-paper px-3 py-2.5">
                          <p class="truncate text-[11px] text-muted">{p.invoice}</p>
                          <p class="tnum font-semibold">{p.amount}</p>
                        </div>
                      </li>
                    ))}
                  </ul>
                  <p class="rc-done mt-5 inline-flex items-center gap-2 rounded-full bg-money/15 px-3 py-1.5 text-sm font-semibold text-money-dark">
                    <span class="h-2 w-2 rounded-full bg-money" />
                    {r.done}
                  </p>
                </div>
              )}

              {piece.id === 'prevision' && (
                <div class="pt-8" data-forecast>
                  <p class="text-sm font-semibold">{f.title}</p>
                  <div class="relative mt-3">
                    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full overflow-visible">
                      <defs>
                        <linearGradient id="fc-bar" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0" stop-color="#6C5CE7" stop-opacity=".35" />
                          <stop offset="1" stop-color="#6C5CE7" stop-opacity=".08" />
                        </linearGradient>
                      </defs>
                      {[0.25, 0.5, 0.75].map((t) => (
                        <line x1={pad.l} x2={W - pad.r} y1={pad.t + (H - pad.t - pad.b) * t} y2={pad.t + (H - pad.t - pad.b) * t} stroke="#0B1020" stroke-opacity=".06" />
                      ))}
                      <rect
                        class="fc-zone"
                        x={pad.l + bw * 5 + 3}
                        y={pad.t - 20}
                        width={bw - 6}
                        height={H - pad.t - pad.b + 20}
                        rx="8"
                        fill="#FF6B6B"
                        fill-opacity=".1"
                      />
                      {cash.map((v, i) => (
                        <rect
                          class="fc-bar"
                          x={pad.l + bw * i + bw * 0.22}
                          y={yOf(v)}
                          width={bw * 0.56}
                          height={H - pad.b - yOf(v)}
                          rx="5"
                          fill={i === 5 ? '#FF6B6B' : 'url(#fc-bar)'}
                          fill-opacity={i === 5 ? 0.55 : 1}
                        />
                      ))}
                      <line class="fc-threshold" x1={pad.l} x2={W - pad.r} y1={threshold} y2={threshold} stroke="#FF6B6B" stroke-width="1.5" stroke-dasharray="4 5" />
                      <path class="fc-line" d={linePath} fill="none" stroke="#2BD67B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                      {pts.map(([x, y], i) => (
                        <circle class="fc-dot" cx={x} cy={y} r={i === 5 ? 5.5 : 4} fill={i === 5 ? '#FF6B6B' : '#2BD67B'} stroke="#fff" stroke-width="2" />
                      ))}
                      {f.weeks.map((w, i) => (
                        <text x={pad.l + bw * i + bw / 2} y={H - 8} text-anchor="middle" font-size="12" fill={i === 5 ? '#B02A2A' : '#5B6275'} font-weight={i === 5 ? 700 : 400}>
                          {w}
                        </text>
                      ))}
                    </svg>
                    <div class="absolute -translate-x-1/2" style={`left:${((pad.l + bw * 5.5) / W) * 100}%;top:0`}>
                      <div class="fc-alert flex items-center gap-1.5 rounded-lg bg-ink px-2.5 py-1.5 text-[11px] font-semibold whitespace-nowrap text-paper shadow-lg sm:text-xs">
                        <span class="h-2 w-2 rounded-full bg-alert" />
                        {f.alert}
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cb-pill-1,
  .cb-pill-2 {
    opacity: 0;
  }
  :global(:root:not(.js-motion)) .cb-pill-0,
  :global(:root:not(.js-motion)) .cb-pill-1 {
    opacity: 0;
  }
  :global(:root:not(.js-motion)) .cb-pill-2 {
    opacity: 1;
  }
</style>
