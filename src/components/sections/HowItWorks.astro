---
import es from '../../content/es';
import Payables from '../demos/Payables.astro';
import Receivables from '../demos/Receivables.astro';
import Treasury from '../demos/Treasury.astro';
import Close from '../demos/Close.astro';
import Taxes from '../demos/Taxes.astro';

const h = es.how;
const demos = {
  proveedores: Payables,
  cobros: Receivables,
  tesoreria: Treasury,
  cierre: Close,
  impuestos: Taxes,
} as const;
---

<section id="como-funciona" class="relative bg-paper py-24 sm:py-32" aria-labelledby="como-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow text-violet" data-reveal>{h.eyebrow}</p>
      <h2 id="como-title" class="h-section mt-5" data-split>{h.title}</h2>
      <p class="mt-6 text-lg text-muted sm:text-xl" data-reveal>{h.intro}</p>
    </div>

    <!-- Índice de módulos -->
    <ol class="mt-10 flex flex-wrap gap-2" data-reveal>
      {
        h.pieces.map((piece) => (
          <li>
            <a
              href={`#${piece.id}`}
              class:list={[
                'inline-flex items-center gap-2 rounded-full border px-3.5 py-2 text-sm font-semibold transition-colors',
                piece.start
                  ? 'border-money bg-money/15 text-ink hover:bg-money/25'
                  : 'border-ink/10 bg-white text-ink hover:border-ink/30',
              ]}
            >
              <span class="tnum text-violet">{piece.number}</span>
              {piece.title}
            </a>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 flex flex-col gap-20 sm:mt-24 sm:gap-28">
      {
        h.pieces.map((piece, idx) => {
          const Demo = demos[piece.id];
          return (
            <article
              id={piece.id}
              class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16"
              aria-labelledby={`${piece.id}-title`}
              data-piece={piece.id}
            >
              <div class:list={['max-w-lg', idx % 2 === 1 && 'lg:order-2 lg:justify-self-end']}>
                <div class="flex flex-wrap items-center gap-3" data-reveal>
                  <p class="tnum font-display text-sm font-bold text-violet">
                    {piece.number} · {piece.kicker}
                  </p>
                  {piece.start && (
                    <span class="start-badge inline-flex items-center gap-1.5 rounded-full bg-money px-3 py-1 text-xs font-bold text-ink">
                      <span class="h-1.5 w-1.5 rounded-full bg-ink" />
                      {h.startHere}
                    </span>
                  )}
                </div>
                <h3 id={`${piece.id}-title`} class="mt-2 font-display text-3xl font-bold sm:text-4xl" data-reveal>
                  {piece.title}
                </h3>
                <p class="mt-4 text-lg text-muted" data-reveal>
                  {piece.text}
                </p>
                <ul class="mt-6 flex flex-col gap-2.5" data-reveal>
                  {piece.points.map((pt) => (
                    <li class="flex items-center gap-3 font-medium">
                      <svg class="h-5 w-5 shrink-0 text-money-dark" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="10" cy="10" r="9" fill="currentColor" opacity=".14" />
                        <path d="M6 10.5l2.5 2.5L14 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {pt}
                    </li>
                  ))}
                </ul>
              </div>

              <div
                class:list={[
                  'demo card-surface relative overflow-hidden p-5 sm:p-7',
                  piece.start && 'ring-2 ring-money/60',
                ]}
                aria-hidden="true"
                data-demo={piece.id}
              >
                <span class="tag-illus absolute top-4 right-4 border-black/10 text-muted">{h.tag}</span>
                <Demo />
              </div>
            </article>
          );
        })
      }
    </div>

    <p
      class="mx-auto mt-20 flex max-w-2xl items-start gap-3 rounded-2xl border border-ink/10 bg-white px-5 py-4 text-muted sm:mt-24"
      data-reveal
    >
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-violet" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 9v5M10 6.2v.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <span>{h.excluded}</span>
    </p>
  </div>
</section>
