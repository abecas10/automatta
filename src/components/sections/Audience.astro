---
import SectionHead from '../SectionHead.astro';
import es from '../../content/es';

const a = es.audience;
const sectorsSentence =
  a.sectors.map((s, i) => (i === 0 ? s : s.toLowerCase())).slice(0, -1).join(', ') + ' y ' + a.sectors[a.sectors.length - 1].toLowerCase() + '.';
---

<section id="para-quien" class="section" aria-labelledby="audiencia-title">
  <div class="container-x">
    <SectionHead name={a.eyebrow} title={a.title} id="audiencia-title" intro={a.text} />

    <div class="mt-14 grid lg:mt-20 lg:grid-cols-12 lg:gap-8">
      <div class="grid gap-12 border-t border-line pt-10 md:grid-cols-2 md:gap-0 md:divide-x md:divide-line lg:col-span-9 lg:col-start-4">
        {
          a.segments.map((s, i) => (
            <article class:list={['flex flex-col', i === 0 ? 'md:pr-10' : 'md:pl-10']}>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <p class="text-[0.9375rem] font-medium text-green">{s.name}</p>
                <p class="tnum text-[0.9375rem] text-muted">{s.range}</p>
              </div>
              <h3 class="h-sub mt-4 max-w-[22ch]" data-rise>{s.headline}</h3>
              <p class="mt-4 text-muted">{s.text}</p>
              <div class="mt-8 rounded-lg bg-paper-2 p-4">
                <p class="text-sm">
                  <span class="tag mr-2 bg-ink/8 align-[1px]">{a.exampleTag}</span>
                  <strong>{s.example.name}.</strong> <span class="text-muted">{s.example.text}</span>
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-14 grid lg:mt-20 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-9 lg:col-start-4">
        <h3 class="text-[0.9375rem] font-medium text-green">{a.sectorsTitle}</h3>
        <p class="t-display mt-4 max-w-[34ch] text-[clamp(1.5rem,1rem+1.8vw,2.4rem)] leading-[1.15] text-ink/85">{sectorsSentence}</p>
      </div>
    </div>
  </div>
</section>
