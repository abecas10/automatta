---
import es from '../../content/es';

const a = es.audience;
const icons: Record<string, string> = {
  Industria: 'M3 20V9l5 3V9l5 3V5h4v15H3z',
  Comercio: 'M4 9h16l-1.5-5h-13zM5 9v11h14V9M10 20v-6h4v6',
  Distribución: 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z',
  Hostelería: 'M7 3v8M5 3v5a2 2 0 004 0V3M7 11v10M17 3c-2 2-2 6 0 8v10',
  Talleres: 'M14.5 6.5a4 4 0 00-5 5L4 17l3 3 5.5-5.5a4 4 0 005-5l-2.5 2.5-2.5-.5-.5-2.5z',
  Clínicas: 'M9 4h6v5h5v6h-5v5H9v-5H4V9h5z',
  'Despachos profesionales': 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
  Construcción: 'M3 20h18M5 20V10l7-5 7 5v10M10 20v-5h4v5',
  Logística: 'M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10',
  Tecnología: 'M4 5h16v11H4zM8 20h8M12 16v4',
};
const rows = [a.sectors, [...a.sectors].reverse()];
---

<section id="para-quien" class="relative overflow-hidden bg-paper-2 py-24 sm:py-32" aria-labelledby="audiencia-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow text-violet" data-reveal>{a.eyebrow}</p>
      <h2 id="audiencia-title" class="h-section mt-5" data-split>{a.title}</h2>
      <p class="mt-6 text-lg text-muted sm:text-xl" data-reveal>{a.text}</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-2 lg:gap-6">
      {
        a.segments.map((s, i) => (
          <article
            class:list={[
              'segment tilt relative flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8',
              i === 0 ? 'card-surface' : 'dark bg-ink text-paper shadow-[0_30px_80px_-30px_rgba(11,16,32,0.6)]',
            ]}
            data-tilt
            data-reveal
          >
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class:list={['eyebrow', i === 0 ? 'text-violet' : 'text-money']}>{s.name}</p>
              <p
                class:list={[
                  'tnum rounded-full px-3 py-1 font-display text-sm font-bold',
                  i === 0 ? 'bg-violet/10 text-violet' : 'bg-money/15 text-money',
                ]}
              >
                {s.range}
              </p>
            </div>
            <h3 class="mt-6 font-display text-3xl leading-[1.05] font-bold sm:text-4xl">{s.headline}</h3>
            <p class:list={['mt-4 text-lg', i === 0 ? 'text-muted' : 'text-paper/75']}>{s.text}</p>

            <div class="min-h-8 flex-1" />
            <div
              class:list={[
                'flex items-start gap-3 rounded-2xl border p-4',
                i === 0 ? 'border-ink/10 bg-paper' : 'border-white/10 bg-white/[0.05]',
              ]}
            >
              <span
                class:list={[
                  'shrink-0 rounded-md px-2 py-0.5 text-[11px] font-bold tracking-wide uppercase',
                  i === 0 ? 'bg-ink text-paper' : 'bg-paper text-ink',
                ]}
              >
                {a.exampleTag}
              </span>
              <p class="text-sm">
                <strong class="font-semibold">{s.example.name}.</strong>{' '}
                <span class:list={[i === 0 ? 'text-muted' : 'text-paper/70']}>{s.example.text}</span>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <h3 class="sr-only">{a.sectorsTitle}</h3>
  <ul
    class="sr-only motion-reduce:not-sr-only motion-reduce:mx-auto motion-reduce:mt-12 motion-reduce:flex motion-reduce:max-w-[1200px] motion-reduce:flex-wrap motion-reduce:gap-3 motion-reduce:px-5"
  >
    {
      a.sectors.map((s) => (
        <li class="motion-reduce:rounded-full motion-reduce:border motion-reduce:border-ink/10 motion-reduce:bg-white motion-reduce:px-5 motion-reduce:py-3 motion-reduce:font-semibold">
          {s}
        </li>
      ))
    }
  </ul>
  <!-- Cinta de sectores: decorativa, los lectores de pantalla leen la lista de arriba -->
  <div class="mt-16 flex flex-col gap-4 motion-reduce:hidden" aria-hidden="true">
    {
      rows.map((row, r) => (
        <div class="marquee overflow-hidden">
          <div class:list={['marquee-track gap-4 pr-4', r === 1 && 'reverse']}>
            {[0, 1].map(() => (
              <div class="flex shrink-0 gap-4">
                {[...row, ...row].map((s) => (
                  <span
                    class:list={[
                      'inline-flex items-center gap-2.5 rounded-full border px-5 py-3 text-base font-semibold whitespace-nowrap sm:text-lg',
                      r === 0 ? 'border-ink/10 bg-white text-ink' : 'border-ink bg-ink text-paper',
                    ]}
                  >
                    <svg
                      class:list={['h-5 w-5', r === 0 ? 'text-violet' : 'text-money']}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path d={icons[s]} />
                    </svg>
                    {s}
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
