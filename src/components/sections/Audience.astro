---
import es from '../../content/es';

const a = es.audience;
const icons: Record<string, string> = {
  Industria: 'M3 20V9l5 3V9l5 3V5h4v15H3z',
  Distribución: 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z',
  'Servicios profesionales': 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
  Ingeniería: 'M12 3l2 3 3.5-.5.5 3.5 3 2-3 2-.5 3.5L14 16l-2 3-2-3-3.5.5L6 13 3 11l3-2-.5-3.5L10 6z',
  Construcción: 'M3 20h18M5 20V10l7-5 7 5v10M10 20v-5h4v5',
  Tecnología: 'M4 5h16v11H4zM8 20h8M12 16v4',
  Logística: 'M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10',
};
const rows = [a.sectors, [...a.sectors].reverse()];
---

<section class="relative overflow-hidden bg-paper-2 py-24 sm:py-32" aria-labelledby="audiencia-title">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow text-violet" data-reveal>{a.eyebrow}</p>
        <h2 id="audiencia-title" class="h-section mt-5" data-split>{a.title}</h2>
        <p class="mt-6 text-lg text-muted sm:text-xl" data-reveal>{a.text}</p>
      </div>
      <dl class="grid grid-cols-3 gap-3" data-reveal>
        {
          a.facts.map((f) => (
            <div class="card-surface tilt p-4 sm:p-5" data-tilt>
              <dt class="sr-only">{f.label}</dt>
              <dd class="tnum font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{f.value}</dd>
              <dd class="mt-1 text-sm leading-tight text-muted">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <h3 class="sr-only">Sectores</h3>
  <ul class="sr-only motion-reduce:not-sr-only motion-reduce:mx-auto motion-reduce:max-w-[1200px] motion-reduce:px-5 motion-reduce:mt-12 motion-reduce:flex motion-reduce:flex-wrap motion-reduce:gap-3">
    {
      a.sectors.map((s) => (
        <li class="motion-reduce:rounded-full motion-reduce:border motion-reduce:border-ink/10 motion-reduce:bg-white motion-reduce:px-5 motion-reduce:py-3 motion-reduce:font-semibold">
          {s}
        </li>
      ))
    }
  </ul>
  <div class="mt-16 flex flex-col gap-4 motion-reduce:hidden" aria-hidden="true">
    {
      rows.map((row, r) => (
        <div class="marquee overflow-hidden">
          <div class:list={['marquee-track gap-4 pr-4', r === 1 && 'reverse']}>
            {[0, 1].map(() => (
              <div class="flex shrink-0 gap-4">
                {[...row, ...row].map((s) => (
                  <span
                    class:list={[
                      'inline-flex items-center gap-2.5 rounded-full border px-5 py-3 text-base font-semibold whitespace-nowrap sm:text-lg',
                      r === 0 ? 'border-ink/10 bg-white text-ink' : 'border-ink bg-ink text-paper',
                    ]}
                  >
                    <svg
                      class:list={['h-5 w-5', r === 0 ? 'text-violet' : 'text-money']}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path d={icons[s]} />
                    </svg>
                    {s}
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
