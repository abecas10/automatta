---
// Escritorio del hero: una factura vencida se cobra, se concilia con el banco y la caja se actualiza.
// Todo escala con el ancho del contenedor (unidades cqi).
import Stamp from '../Stamp.astro';
import es from '../../content/es';

const d = es.hero.desk;
const inv = d.invoice;
const chart = 'M0 54 C 30 50, 50 56, 80 44 S 130 38, 160 30 S 210 26, 240 16';
---

<figure class="desk relative" aria-label={es.hero.illustrationLabel} role="img" data-desk>
  <div class="desk-surface absolute inset-0" aria-hidden="true"></div>

  <!-- Factura -->
  <article class="doc desk-invoice absolute" data-desk-invoice aria-hidden="true">
    <div class="flex items-start justify-between gap-[2cqi]">
      <div>
        <p class="t-data text-[2.2cqi] text-muted">{inv.kind}</p>
        <p class="t-display text-[4.4cqi] leading-none">{inv.number}</p>
      </div>
      <p class="t-data text-[2.2cqi] text-muted">{inv.date}</p>
    </div>
    <div class="mt-[3.2cqi] grid grid-cols-[auto_1fr] gap-[3cqi] text-[2.2cqi] leading-tight">
      <div>
        <p class="t-data text-muted">Emisor</p>
        <p class="mt-[0.4cqi] font-medium">{inv.issuer}</p>
      </div>
      <div>
        <p class="t-data text-muted">Cliente</p>
        <p class="mt-[0.4cqi] font-medium">{inv.client}</p>
      </div>
    </div>
    <div class="mt-[3.2cqi] border-t border-line pt-[2cqi] text-[2.3cqi]">
      <div class="flex justify-between gap-[2cqi]">
        <span>{inv.concept}</span>
        <span class="tnum">{inv.lines[0].value}</span>
      </div>
      {
        inv.lines.map((l) => (
          <div class="mt-[1.2cqi] flex justify-between gap-[2cqi] text-muted">
            <span>{l.label}</span>
            <span class="tnum">{l.value}</span>
          </div>
        ))
      }
      <div class="mt-[2cqi] flex items-baseline justify-between border-t border-line pt-[2cqi]">
        <span class="font-medium">{inv.totalLabel}</span>
        <span class="t-display tnum text-[4cqi]">{inv.total}</span>
      </div>
    </div>
    <div class="mt-[3cqi] flex items-center justify-between text-[2.2cqi]">
      <span class="text-muted">{inv.due}</span>
      <span class="pill pill-red !text-[2cqi]" data-desk-overdue>{inv.overdue}</span>
    </div>
    <Stamp label={inv.paid} note={inv.paidNote} rotate={-9} press class="desk-stamp absolute text-[4.2cqi]" />
  </article>

  <!-- Extracto del banco -->
  <aside class="doc-ink desk-bank absolute" data-desk-bank aria-hidden="true">
    <div class="flex items-baseline justify-between">
      <p class="t-display text-[3cqi]">{d.bank.title}</p>
      <p class="t-data text-[2cqi] text-muted-dark">{d.bank.subtitle}</p>
    </div>
    <ul class="mt-[2.4cqi] flex flex-col gap-[1.4cqi] text-[2.2cqi]">
      {
        d.bank.rows.map((r) => (
          <li class="desk-bank-row flex items-center gap-[1.6cqi] rounded-md px-[1.6cqi] py-[1.4cqi]" data-match={r.match ? '' : undefined}>
            <span class="min-w-0 flex-1 truncate">{r.label}</span>
            <span class="tnum shrink-0">{r.amount}</span>
            <span class="desk-check grid h-[3cqi] w-[3cqi] shrink-0 place-items-center rounded-full bg-mint text-ink">
              <svg viewBox="0 0 16 16" class="h-[2cqi] w-[2cqi]" fill="none">
                <path d="M3.5 8.5l3 3L12.5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="desk-matched mt-[2cqi] text-[2cqi] text-mint" data-desk-matched>{d.bank.matched} {inv.number}</p>
  </aside>

  <!-- Previsión de caja -->
  <aside class="doc desk-forecast absolute" data-desk-forecast aria-hidden="true">
    <div class="flex items-baseline justify-between">
      <p class="text-[2.2cqi] text-muted">{d.forecast.title}</p>
      <p class="t-display tnum text-[3.4cqi]">{d.forecast.value}</p>
    </div>
    <svg viewBox="0 0 240 60" class="mt-[1.6cqi] h-auto w-full overflow-visible" preserveAspectRatio="none">
      <path d="M0 20H240M0 40H240" stroke="#14201B" stroke-opacity=".08"></path>
      <path class="desk-line" d={chart} fill="none" stroke="#1F6B4A" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
      <circle class="desk-dot" cx="240" cy="16" r="4" fill="#1F6B4A"></circle>
      <circle class="desk-dot-pulse" cx="240" cy="16" r="4" fill="none" stroke="#1F6B4A" stroke-width="1.5"></circle>
    </svg>
    <div class="t-data mt-[1cqi] flex justify-between text-[1.9cqi] text-muted">
      {d.forecast.labels.map((l) => <span>{l}</span>)}
    </div>
  </aside>

  <!-- Aviso final -->
  <p class="desk-toast absolute rounded-md bg-ink px-[2.2cqi] py-[1.6cqi] text-[2.1cqi] leading-snug text-paper" data-desk-toast aria-hidden="true">
    {d.toast}
  </p>
</figure>

<style>
  .desk {
    container-type: inline-size;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .desk {
      aspect-ratio: 5 / 4.4;
      max-width: none;
    }
  }
  .desk-invoice {
    left: 4cqi;
    top: 6cqi;
    width: 50cqi;
    padding: 4cqi 4cqi 6cqi;
    z-index: 2;
  }
  /* El sello es un componente hijo: el selector debe ser global para alcanzarlo.
     Cae donde estaba la etiqueta "Vencida", sin tapar el total. */
  :global(.desk-stamp) {
    right: 2.5cqi;
    bottom: 1.5cqi;
    z-index: 7;
  }
  .desk-bank {
    right: 4cqi;
    top: 8cqi;
    width: 40cqi;
    padding: 3.2cqi;
    z-index: 4;
  }
  .desk-bank-row {
    background: rgb(245 246 243 / 0.06);
  }
  .desk-check {
    opacity: 0;
    transform: scale(0.4);
  }
  .desk-bank-row.is-matched {
    background: rgb(143 211 178 / 0.14);
  }
  .desk-bank-row.is-matched .desk-check {
    opacity: 1;
    transform: none;
  }
  .desk-forecast {
    right: 4cqi;
    bottom: 6cqi;
    width: 40cqi;
    padding: 3cqi 3.2cqi;
    z-index: 5;
  }
  .desk-toast {
    right: 4cqi;
    top: 50cqi;
    width: 40cqi;
    z-index: 6;
  }
  .desk-dot-pulse {
    transform-origin: 240px 16px;
    animation: desk-pulse 2.4s ease-out infinite;
  }
  @keyframes desk-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  /* Sin animación: estado final (cobrada, conciliada, previsión dibujada) */
  :global(:root:not(.js-motion)) .desk-check {
    opacity: 1;
    transform: none;
  }
  :global(:root:not(.js-motion)) [data-match] {
    background: rgb(143 211 178 / 0.14);
  }
  :global(:root:not(.js-motion)) [data-desk-overdue] {
    opacity: 0;
  }
  :global(.js-motion) .desk-matched,
  :global(.js-motion) .desk-toast,
  :global(.js-motion) .desk-dot,
  :global(.js-motion) .desk-dot-pulse {
    opacity: 0;
  }
</style>
