---
// Sello de caucho. Con animación se "estampa" desde JS (data-press); sin ella ya está puesto.
interface Props {
  label: string;
  note?: string;
  tone?: 'green' | 'red' | 'ink';
  rotate?: number;
  press?: boolean;
  class?: string;
}
const { label, note, tone = 'green', rotate = -7, press = false, class: className = '' } = Astro.props;
---

<span
  class:list={['stamp', tone === 'red' && 'stamp-red', tone === 'ink' && 'stamp-ink', className]}
  style={`--rot:${rotate}deg`}
  data-press={press ? '' : undefined}
  aria-hidden="true"
>
  {label}
  {note && <small>{note}</small>}
</span>
