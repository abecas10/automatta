---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import es from '../content/es';
import { SITE_URL, SITE_NAME, CONTACT_EMAIL } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** La página tiene escenario 3D (solo la portada). */
  world?: boolean;
}

const { title = es.meta.title, description = es.meta.description, noindex = false, world = false } = Astro.props;
// URLs limpias: /index.html → /, /aviso-legal.html → /aviso-legal
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cleanPath, SITE_URL).href;
const ogImage = new URL('/og.png', SITE_URL).href;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  logo: new URL('/logo.png', SITE_URL).href,
  email: CONTACT_EMAIL,
  description: es.meta.orgDescription,
  founder: es.team.founders.map((f) => ({ '@type': 'Person', name: f.name, jobTitle: f.role })),
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
  areaServed: 'Cataluña',
};
---

<!doctype html>
<html lang="es" data-world={world ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F5F6F3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={es.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <!--
      Analítica: cuando queráis medir visitas sin cookies, activad Vercel Web Analytics
      en el panel de Vercel e instalad `@vercel/analytics`. Después añadid aquí:
        import Analytics from '@vercel/analytics/astro';
        <Analytics />
      (No usa cookies, así que no hace falta banner.)
    -->

    <!-- Marca el documento para animar solo si hay JS y no se pide movimiento reducido.
         Si el JS no llega a ejecutarse en 4 s, se muestra todo igualmente. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('js-motion');
          // ¿Escenario 3D? Se decide aquí, antes de pintar, para que la maquetación no salte.
          // Solo en la portada, con WebGL y sin ahorro de datos.
          try {
            var c = document.createElement('canvas');
            var gl = c.getContext('webgl2') || c.getContext('webgl');
            var save = navigator.connection && navigator.connection.saveData;
            if (gl && !save && d.hasAttribute('data-world')) d.classList.add('has-world');
            if (gl && gl.getExtension('WEBGL_lose_context')) gl.getExtension('WEBGL_lose_context').loseContext();
          } catch (e) {}
          window.__motionFallback = setTimeout(function () {
            d.classList.remove('js-motion', 'has-world');
          }, 4000);
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only z-[200] rounded-md bg-ink px-4 py-2 font-medium text-paper focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{es.nav.skip}</a
    >
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
