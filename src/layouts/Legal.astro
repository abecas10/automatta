---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/sections/Footer.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={`${title} · Automatta`} description={description}>
  <Navbar />
  <main id="contenido">
    <header class="pt-36 pb-12">
      <div class="container-x">
        <h1 class="h-section">{title}</h1>
        <p class="mt-4 text-muted">Última actualización: {updated}</p>
      </div>
    </header>
    <article class="legal container-x max-w-3xl border-t border-line py-12 sm:py-16">
      <slot />
    </article>
  </main>
  <Footer showCta={false} />
</Base>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
  }
  .legal :global(p),
  .legal :global(li) {
    margin-top: 0.9rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(a) {
    color: var(--color-green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal :global(mark) {
    background: var(--color-red-soft);
    color: var(--color-red);
    padding: 0 0.25em;
    border-radius: 4px;
    font-weight: 500;
  }
</style>
